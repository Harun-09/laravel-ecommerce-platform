APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Auto run initial setup on first web request (for no-SSH/shared hosting deploy)
AUTO_WEB_SETUP_ENABLED=false
WEB_SETUP_ENABLED=false
WEB_SETUP_TOKEN=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Set true on shared hosting when you cannot run `php artisan storage:link`
PUBLIC_DISK_USE_PUBLIC_PATH=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_SUPPORT_EMAIL="${MAIL_FROM_ADDRESS}"
CONTACT_SUPPORT_NAME="${APP_NAME} Support"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_MODE=sandbox
STRIPE_SANDBOX_PUBLIC_KEY=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_LIVE_PUBLIC_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
STRIPE_BRAND_DISPLAY_NAME=NovaMart
STRIPE_BRAND_BUTTON_COLOR=#1d4ed8
STRIPE_BRAND_BACKGROUND_COLOR=#f8fafc
STRIPE_BRAND_BORDER_STYLE=rounded
STRIPE_BRAND_FONT_FAMILY=inter
STRIPE_BRAND_LOGO_URL=
STRIPE_BRAND_ICON_URL=

SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Optional: limit gateway options shown on SSLCOMMERZ page (use merchant-supported codes only)
SSLCOMMERZ_MULTI_CARD_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
STOREFRONT_DEFAULT_LOCALE=en
STOREFRONT_DEFAULT_CURRENCY=BDT
STOREFRONT_BASE_CURRENCY=BDT

SMS_ENABLED=false
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=NovaMart
SMS_TIMEOUT=10
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_PROVIDER=sentry
ERROR_TRACKING_ENVIRONMENT="${APP_ENV}"
SENTRY_DSN=
BUGSNAG_API_KEY=
OBS_PAYMENT_FAILURE_THRESHOLD=3
OBS_PAYMENT_FAILURE_WINDOW_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
